        <field name="date_from">2026-01-01</field>
        <field name="parameter_value">0.0165</field>
    </record>

    <!-- Cotisation normes du travail : 0,06 % de la rémunération assujettie,
         plafonnée à 103 000 $ de rémunération/employé → cotisation max 61,80 $
         (Revenu Québec, cotisation relative aux normes du travail 2026,
         formulaire LE-39.0.2) -->
    <record id="val_qc_normes_travail_2026" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_qc_normes_travail"/>
        <field name="date_from">2026-01-01</field>
        <field name="parameter_value">{'taux': 0.0006, 'max': 61.80}</field>
    </record>

    <!-- Indemnité de vacances (Loi sur les normes du travail) : 4 % du brut
         (moins de 3 ans de service continu), 6 % (3 ans et plus). Taux légaux
         stables, non indexés annuellement — datés par cohérence d'architecture. -->
    <record id="val_qc_vacances_2026" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_qc_vacances"/>
        <field name="date_from">2026-01-01</field>
        <field name="parameter_value">{'taux_moins_3_ans': 0.04, 'taux_3_ans_plus': 0.06, 'seuil_annees': 3}</field>
    </record>

