<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      ================================================================
      BARÈMES 2026 — À COMPTER DU 1er JANVIER 2026
      ================================================================
      Sources :
        - Revenu Québec, TP-1015.F (version 2026-01)
        - Agence du revenu du Canada, T4127 (CSV du guide)
      Chaque valeur est une structure Python évaluée par safe_eval.
      NE PAS modifier dans l'interface : ces barèmes sont légaux et datés.
      Pour 2027, créer un fichier ..._value_2027_data.xml avec
      date_from = 2027-01-01 ; l'ancien reste pour rejouer l'historique.
    -->

    <!-- ============ QUÉBEC ============ -->

    <!-- RRQ : taux total 6,30 % (base 5,30 % + 1re suppl. 1,00 %),
         exemption 3 500 $, cotisation max employé 4 479,30 $ (T4127 tab. 8.3/8.5) -->
    <record id="val_qc_rrq_2026" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_qc_rrq"/>
        <field name="date_from">2026-01-01</field>
        <field name="parameter_value">{'taux': 0.063, 'taux_supplementaire': 0.01, 'exemption': 3500.0, 'max': 4479.30}</field>
    </record>

    <!-- RRQ2 : 2e cotisation supplémentaire 4 % entre MGA 74 600 $ et MSGA 85 000 $,
         max 416 $ (T4127 tab. 8.6) -->
    <record id="val_qc_rrq2_2026" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_qc_rrq2"/>
        <field name="date_from">2026-01-01</field>
        <field name="parameter_value">{'taux': 0.04, 'mga': 74600.0, 'msga': 85000.0, 'max': 416.0}</field>
    </record>

    <!-- RQAP : employé 0,430 % (max 442,90 $), employeur 0,602 % (max 620,06 $)
         (T4127 tab. 8.8) -->
    <record id="val_qc_rqap_2026" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_qc_rqap"/>
        <field name="date_from">2026-01-01</field>
        <field name="parameter_value">{'taux_employe': 0.0043, 'max_employe': 442.90, 'taux_employeur': 0.00602, 'max_employeur': 620.06}</field>
    </record>

    <!-- AE (taux réduit QC) : employé 1,30 % (max 895,70 $),
         employeur 1,82 % (max 1 253,98 $) (T4127 tab. 8.7) -->
    <record id="val_qc_ae_2026" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_qc_ae"/>
        <field name="date_from">2026-01-01</field>
        <field name="parameter_value">{'taux_employe': 0.013, 'max_employe': 895.70, 'taux_employeur': 0.0182, 'max_employeur': 1253.98}</field>
    </record>

