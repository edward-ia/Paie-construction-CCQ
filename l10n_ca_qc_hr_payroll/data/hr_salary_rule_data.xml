<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Règles de la structure « Paie régulière — Québec ».
      Toute la logique vit dans les méthodes _l10n_ca_qc_* de hr.payslip ;
      les règles ne font que les appeler, pour garder les formules testables
      et hors de la base de données.
      Ordre (sequence) : BASIC -> cotisations employé -> impôts -> NET,
      puis cotisations employeur (n'affectent pas le net).
    -->

    <!-- 10 — Salaire de base (brut de la période) -->
    <record id="rule_qc_basic" model="hr.salary.rule">
        <field name="name">Salaire de base</field>
        <field name="code">BASIC</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_basic()</field>
    </record>

    <!-- 20 — Salaire brut imposable -->
    <record id="rule_qc_gross" model="hr.salary.rule">
        <field name="name">Salaire brut</field>
        <field name="code">GROSS</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="hr_payroll.GROSS"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories['BASIC']</field>
    </record>

    <!-- 30 — RRQ (part employé) -->
    <record id="rule_qc_rrq" model="hr.salary.rule">
        <field name="name">RRQ</field>
        <field name="code">RRQ</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._l10n_ca_qc_rrq(categories['GROSS'])</field>
    </record>

    <!-- 31 — RRQ2 (part employé) -->
    <record id="rule_qc_rrq2" model="hr.salary.rule">
        <field name="name">RRQ — cotisation supplémentaire 2</field>
        <field name="code">RRQ2</field>
        <field name="sequence">31</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._l10n_ca_qc_rrq2(categories['GROSS'])</field>
    </record>

    <!-- 32 — RQAP (part employé) -->
    <record id="rule_qc_rqap" model="hr.salary.rule">
        <field name="name">RQAP</field>
        <field name="code">RQAP</field>
        <field name="sequence">32</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._l10n_ca_qc_rqap(categories['GROSS'])</field>
    </record>

    <!-- 33 — Assurance-emploi (part employé) -->
    <record id="rule_qc_ae" model="hr.salary.rule">
        <field name="name">Assurance-emploi</field>
        <field name="code">AE</field>
        <field name="sequence">33</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._l10n_ca_qc_ae(categories['GROSS'])</field>
    </record>

    <!-- 40 — Impôt du Québec -->
    <record id="rule_qc_impot_qc" model="hr.salary.rule">
        <field name="name">Impôt du Québec</field>
        <field name="code">IMPOT_QC</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._l10n_ca_qc_impot_qc(categories['GROSS'])</field>
    </record>

    <!-- 41 — Impôt fédéral (les cotisations réduisent son assiette : calculé après) -->
    <record id="rule_qc_impot_fed" model="hr.salary.rule">
        <field name="name">Impôt fédéral</field>
        <field name="code">IMPOT_FED</field>
        <field name="sequence">41</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._l10n_ca_qc_impot_fed(categories['GROSS'])</field>
    </record>

    <!-- 90 — Salaire net -->
    <record id="rule_qc_net" model="hr.salary.rule">
        <field name="name">Salaire net</field>
        <field name="code">NET</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="hr_payroll.NET"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories['BASIC'] + categories['DED']</field>
    </record>

    <!-- ===== Cotisations de l'employeur (n'affectent pas le net) ===== -->

    <!-- 100 — RRQ employeur -->
    <record id="rule_qc_rrq_emp" model="hr.salary.rule">
        <field name="name">RRQ — part employeur</field>
        <field name="code">RRQ_EMP</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_rrq_employeur(categories['GROSS'])</field>
    </record>

    <!-- 101 — RRQ2 employeur -->
    <record id="rule_qc_rrq2_emp" model="hr.salary.rule">
        <field name="name">RRQ2 — part employeur</field>
        <field name="code">RRQ2_EMP</field>
        <field name="sequence">101</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_rrq2_employeur(categories['GROSS'])</field>
    </record>

    <!-- 102 — RQAP employeur -->
    <record id="rule_qc_rqap_emp" model="hr.salary.rule">
        <field name="name">RQAP — part employeur</field>
        <field name="code">RQAP_EMP</field>
        <field name="sequence">102</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_rqap_employeur(categories['GROSS'])</field>
    </record>

    <!-- 103 — AE employeur -->
    <record id="rule_qc_ae_emp" model="hr.salary.rule">
        <field name="name">Assurance-emploi — part employeur</field>
        <field name="code">AE_EMP</field>
        <field name="sequence">103</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_ae_employeur(categories['GROSS'])</field>
    </record>

    <!-- 104 — FSS -->
    <record id="rule_qc_fss" model="hr.salary.rule">
        <field name="name">FSS</field>
        <field name="code">FSS</field>
        <field name="sequence">104</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_fss(categories['GROSS'])</field>
    </record>

    <!-- 105 — CNESST -->
    <record id="rule_qc_cnesst" model="hr.salary.rule">
        <field name="name">CNESST</field>
        <field name="code">CNESST</field>
        <field name="sequence">105</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_cnesst(categories['GROSS'])</field>
    </record>

    <!-- 106 — Cotisation normes du travail (0,06 %, remise annuelle à RQ) -->
    <record id="rule_qc_normes_travail" model="hr.salary.rule">
        <field name="name">Cotisation normes du travail</field>
        <field name="code">CNT</field>
        <field name="sequence">106</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_normes_travail(categories['GROSS'])</field>
    </record>

    <!-- 107 — Provision d'indemnité de vacances (4/6 %) — due à l'employé,
         PAS une remise à un gouvernement ; n'entre pas dans le net -->
    <record id="rule_qc_vacances" model="hr.salary.rule">
        <field name="name">Provision vacances</field>
        <field name="code">VAC</field>
        <field name="sequence">107</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ca_qc_vacances(categories['GROSS'])</field>
    </record>
</odoo>
