<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Bouton explicite pour le sommaire de remise. Le bouton « Imprimer » natif
      de la fiche est codé en dur (action_print_payslip) et n'expose pas les
      rapports liés ; on ajoute donc notre propre bouton, sur la fiche ET sur la
      liste (pour agréger plusieurs fiches sélectionnées → sommaire annuel).
    -->

    <record id="view_hr_payslip_form_sommaire" model="ir.ui.view">
        <field name="name">hr.payslip.form.sommaire.remise</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_print_payslip']" position="after">
                <button name="%(action_report_sommaire_remise)d"
                        type="action"
                        string="Sommaire employeur"
                        invisible="not line_ids"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_tree_sommaire" model="ir.ui.view">
        <field name="name">hr.payslip.list.sommaire.remise</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_print_payslip']" position="after">
                <button name="%(action_report_sommaire_remise)d"
                        type="action"
                        string="Sommaire de remise"/>
            </xpath>
        </field>
    </record>
</odoo>
