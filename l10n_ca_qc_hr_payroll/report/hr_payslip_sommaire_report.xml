<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Sommaire de remise employeur : agrège les fiches de paie SÉLECTIONNÉES et
      regroupe les montants PAR AGENCE (Revenu Québec, ARC, CNESST). Sert à
      déclarer/remettre sans recalcul. Sélectionner un employé = sa part ;
      sélectionner toutes les fiches d'une année = le sommaire annuel global.
      La provision de vacances est présentée à part : elle est DUE à l'employé,
      elle n'est remise à aucun gouvernement.
    -->

    <record id="action_report_sommaire_remise" model="ir.actions.report">
        <field name="name">Sommaire de remise employeur</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ca_qc_hr_payroll.report_sommaire_remise</field>
        <field name="report_file">l10n_ca_qc_hr_payroll.report_sommaire_remise</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sommaire_remise">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="mb-1">Sommaire de remise — Employeur</h2>
                    <p class="text-muted mt-0">
                        Période du
                        <span t-out="date_from" t-options="{'widget': 'date'}"/>
                        au
                        <span t-out="date_to" t-options="{'widget': 'date'}"/>
                        —
                        <span t-out="nb_employees"/> employé(s),
                        <span t-out="nb_slips"/> fiche(s) de paie
                    </p>
                    <p t-if="nb_draft" class="text-danger" style="font-size:10px;">
                        Attention : <span t-out="nb_draft"/> fiche(s) encore en brouillon
                        sont incluses dans ces totaux.
                    </p>

                    <!-- Revenu Québec -->
                    <table class="table table-sm mt-3">
                        <thead class="table-light">
                            <tr>
                                <th>À remettre à Revenu Québec<span t-if="company.l10n_ca_qc_rs_number" style="font-weight:normal;font-size:10px;"> — compte RS <t t-out="company.l10n_ca_qc_rs_number"/></span></th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Impôt du Québec (retenu sur l'employé)</td>
                                <td class="text-end" t-out="rq['impot_qc']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                            <tr>
                                <td>RRQ — employé + employeur (incl. RRQ2)</td>
                                <td class="text-end" t-out="rq['rrq']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                            <tr>
                                <td>RQAP — employé + employeur</td>
                                <td class="text-end" t-out="rq['rqap']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                            <tr>
                                <td>FSS (employeur)</td>
                                <td class="text-end" t-out="rq['fss']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                            <tr>
                                <td>Cotisation normes du travail (employeur)</td>
                                <td class="text-end" t-out="rq['cnt']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                            <tr class="table-active">
                                <td><strong>Total Revenu Québec</strong></td>
                                <td class="text-end"><strong t-out="rq['total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ARC -->
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>À remettre à l'Agence du revenu du Canada (ARC)<span t-if="company.l10n_ca_qc_rp_number" style="font-weight:normal;font-size:10px;"> — compte RP <t t-out="company.l10n_ca_qc_rp_number"/></span></th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Impôt fédéral (retenu sur l'employé)</td>
                                <td class="text-end" t-out="arc['impot_fed']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                            <tr>
                                <td>Assurance-emploi — employé + employeur</td>
                                <td class="text-end" t-out="arc['ae']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                            <tr class="table-active">
                                <td><strong>Total ARC</strong></td>
                                <td class="text-end"><strong t-out="arc['total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- CNESST -->
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>À remettre à la CNESST</th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Prime SST (selon le taux de l'entreprise)</td>
                                <td class="text-end" t-out="cnesst" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Provision vacances (non remise) -->
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Dû aux employés (non remis à un gouvernement)</th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Provision d'indemnité de vacances</td>
                                <td class="text-end" t-out="vacances" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Détail par employé -->
                    <h4 class="mt-4">Détail par employé</h4>
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Employé</th>
                                <th class="text-end">Revenu Québec</th>
                                <th class="text-end">ARC</th>
                                <th class="text-end">CNESST</th>
                                <th class="text-end">Vacances</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="per_employee" t-as="e">
                                <td t-out="e['name']"/>
                                <td class="text-end" t-out="e['rq']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                <td class="text-end" t-out="e['arc']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                <td class="text-end" t-out="e['cnesst']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                <td class="text-end" t-out="e['vacances']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </tr>
                        </tbody>
                    </table>

                    <p class="text-muted mt-4" style="font-size:9px;">
                        Les montants « Revenu Québec » et « ARC » incluent les retenues prélevées
                        sur les employés ET les cotisations de l'employeur, car l'employeur remet
                        les deux. La prime CNESST est versée séparément selon les acomptes établis
                        par la CNESST. La provision de vacances est une somme due aux employés,
                        elle n'est remise à aucune agence.
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
