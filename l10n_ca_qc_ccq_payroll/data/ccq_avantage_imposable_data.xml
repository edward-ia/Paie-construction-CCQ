<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Avantage imposable des régimes d'assurance — métier 416, secteur
      institutionnel et commercial, en vigueur le 26 avril 2026.

      Relevé sur l'outil des taux de salaire de la CCQ, section « Avantages
      imposables ». Ces montants se relèvent, ils ne se dérivent pas de la
      cotisation patronale de prévoyance : voir la docstring du modèle.

      L'écart entre les deux annexes (3,303 $ et 3,333 $) suffit à montrer que le
      montant suit le groupe d'annexes, alors que la cotisation patronale de
      prévoyance est la même partout.

      Fichier SANS noupdate : un montant révisé en cours de période doit pouvoir
      se corriger par une mise à jour du module.
    -->

    <record id="avantage_imposable_416_c3_2026" model="ccq.avantage.imposable">
        <field name="metier_id" ref="metier_416"/>
        <field name="secteur_id" ref="secteur_ic"/>
        <field name="annexe_id" ref="annexe_ic_c"/>
        <field name="date_debut">2026-04-26</field>
        <field name="montant_horaire">3.303</field>
        <field name="note">Annexe C3 au rapport mensuel. Assurance vie et maladie seulement.</field>
    </record>

    <record id="avantage_imposable_416_c6_2026" model="ccq.avantage.imposable">
        <field name="metier_id" ref="metier_416"/>
        <field name="secteur_id" ref="secteur_ic"/>
        <field name="annexe_id" ref="annexe_ic_c1"/>
        <field name="date_debut">2026-04-26</field>
        <field name="montant_horaire">3.333</field>
        <field name="note">Annexe C6 au rapport mensuel. Assurance vie et maladie seulement.</field>
    </record>

</odoo>
