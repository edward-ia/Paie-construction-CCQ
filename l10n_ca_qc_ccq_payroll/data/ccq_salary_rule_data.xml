<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Règles de paie de la couche construction.

      Elles se greffent sur la structure « Paie régulière — Québec » du module
      de base : le bulletin d'un salarié de chantier et celui d'un salarié de
      bureau restent le même document, seules les lignes diffèrent.

      Catégorie BASIC et séquences 11 et 12 : les heures majorées sont donc
      reprises telles quelles par le brut (séquence 20) et par le net
      (séquence 90), et servent d'assiette aux cotisations comme à l'indemnité
      de vacances — ce qui est exact, le temps supplémentaire est un revenu
      d'emploi ordinaire, imposé normalement.

      Le brut des heures régulières n'a pas sa propre règle : la règle BASIC du
      module de base appelle _l10n_ca_qc_basic(), que ce module surcharge.
    -->

    <!-- 11 — Heures supplémentaires à taux et demi -->
    <record id="rule_ccq_heures_supp_50" model="hr.salary.rule">
        <field name="name">Heures supplémentaires (+50 %)</field>
        <field name="code">CCQ_HS50</field>
        <field name="sequence">11</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_heures_supp_50()</field>
    </record>

    <!-- 12 — Heures supplémentaires à taux double -->
    <record id="rule_ccq_heures_supp_100" model="hr.salary.rule">
        <field name="name">Heures supplémentaires (+100 %)</field>
        <field name="code">CCQ_HS100</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_heures_supp_100()</field>
    </record>

    <record id="rule_ccq_primes" model="hr.salary.rule">
        <field name="name">Primes de convention</field>
        <field name="code">CCQ_PRIMES</field>
        <field name="sequence">13</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_primes()</field>
    </record>

    <!--
      34 à 36 — Avantages sociaux précomptés sur le salaire.

      Placées après les cotisations gouvernementales et AVANT les impôts, dont la
      part retraite réduit l'assiette : c'est une cotisation à un régime de pension
      agréé, portée au module de base par _l10n_ca_qc_deductions_rpa().

      Catégorie DED et montant négatif, comme le RRQ et l'AE : le net de la règle
      NET est la somme de BASIC et de DED.
    -->

    <record id="rule_ccq_av_soc_prevoyance" model="hr.salary.rule">
        <field name="name">Avantages sociaux — assurance</field>
        <field name="code">CCQ_AS_PREVOYANCE</field>
        <field name="sequence">34</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._ccq_av_soc_assurance('salarie')</field>
    </record>

    <record id="rule_ccq_av_soc_taxe" model="hr.salary.rule">
        <field name="name">Taxe sur l'assurance (9 %)</field>
        <field name="code">CCQ_AS_TAXE</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._ccq_av_soc_taxe('salarie')</field>
    </record>

    <record id="rule_ccq_av_soc_retraite" model="hr.salary.rule">
        <field name="name">Avantages sociaux — retraite</field>
        <field name="code">CCQ_AS_RETRAITE</field>
        <field name="sequence">36</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._ccq_av_soc_retraite('salarie')</field>
    </record>

    <record id="rule_ccq_prelevement_salarie" model="hr.salary.rule">
        <field name="name">Prélèvement CCQ (0,75 %)</field>
        <field name="code">CCQ_PRELEVEMENT</field>
        <field name="sequence">37</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._ccq_prelevement_salarie()</field>
    </record>

    <record id="rule_ccq_contribution_sectorielle" model="hr.salary.rule">
        <field name="name">Contribution sectorielle</field>
        <field name="code">CCQ_CONTRIB_SECT</field>
        <field name="sequence">38</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._ccq_contribution_sectorielle_salarie()</field>
    </record>

    <!--
      Charges de l'employeur. Catégorie COMP : elles n'entrent pas dans le net.

      Ce sont des PROVISIONS au bulletin hebdomadaire. Les trois se calculent
      « au cours du mois précédant le rapport mensuel » et se versent avec lui ;
      l'obligation légale suit donc le rapport, pas la semaine de paie.
    -->

    <record id="rule_ccq_prelevement_employeur" model="hr.salary.rule">
        <field name="name">Prélèvement CCQ — part employeur (0,75 %)</field>
        <field name="code">CCQ_PRELEVEMENT_EMP</field>
        <field name="sequence">111</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_prelevement_employeur()</field>
    </record>

    <record id="rule_ccq_fonds_formation" model="hr.salary.rule">
        <field name="name">Fonds de formation</field>
        <field name="code">CCQ_FORMATION</field>
        <field name="sequence">112</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_fonds_formation()</field>
    </record>

    <record id="rule_ccq_fonds_indemnisation" model="hr.salary.rule">
        <field name="name">Fonds d'indemnisation</field>
        <field name="code">CCQ_INDEMNISATION</field>
        <field name="sequence">113</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_fonds_indemnisation()</field>
    </record>

    <!--
      114 à 116 — Avantages sociaux à la charge de l'employeur.

      Poste patronal le plus lourd du bulletin, plus élevé à lui seul que toutes
      les cotisations gouvernementales réunies. La ligne d'assurance porte les
      deux caisses ensemble : la caisse de prévoyance et la caisse supplémentaire
      sont dues au même titre et à la même échéance, et leur distinction ne sert
      qu'au rapport mensuel.
    -->

    <record id="rule_ccq_av_soc_prevoyance_emp" model="hr.salary.rule">
        <field name="name">Avantages sociaux — assurance (part employeur)</field>
        <field name="code">CCQ_AS_PREVOYANCE_EMP</field>
        <field name="sequence">114</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_av_soc_assurance('employeur')</field>
    </record>

    <record id="rule_ccq_av_soc_taxe_emp" model="hr.salary.rule">
        <field name="name">Taxe sur l'assurance (9 %) — part employeur</field>
        <field name="code">CCQ_AS_TAXE_EMP</field>
        <field name="sequence">115</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_av_soc_taxe('employeur')</field>
    </record>

    <record id="rule_ccq_av_soc_retraite_emp" model="hr.salary.rule">
        <field name="name">Avantages sociaux — retraite (part employeur)</field>
        <field name="code">CCQ_AS_RETRAITE_EMP</field>
        <field name="sequence">116</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_av_soc_retraite('employeur')</field>
    </record>

    <record id="rule_ccq_contribution_sectorielle_emp" model="hr.salary.rule">
        <field name="name">Contribution sectorielle — part employeur</field>
        <field name="code">CCQ_CONTRIB_SECT_EMP</field>
        <field name="sequence">117</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_contribution_sectorielle_employeur()</field>
    </record>

    <record id="rule_ccq_associations_patronales" model="hr.salary.rule">
        <field name="name">Cotisations aux associations patronales</field>
        <field name="code">CCQ_ASSOC_PATRONALES</field>
        <field name="sequence">118</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_associations_patronales()</field>
    </record>

    <!--
      Ligne d'information, non versée et non retenue. Elle explique au salarié
      pourquoi son impôt du Québec dépasse ce que son salaire seul justifierait.
      Le feuillet de fin d'année est émis par la Commission, jamais par
      l'employeur : ne pas le reporter sur le T4 qu'il remet.
    -->

    <record id="rule_ccq_avantage_imposable" model="hr.salary.rule">
        <field name="name">Avantage imposable — assurance (imposé au Québec seulement)</field>
        <field name="code">CCQ_AVANTAGE_IMPOSABLE</field>
        <field name="sequence">119</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_avantage_imposable()</field>
    </record>

    <!--
      Frais de participation aux régimes — R-20 article 126.0.2.
      Le prix du maintien volontaire des avantages sociaux sur des heures qui
      sortent du champ de la loi : 0,075 $ l'heure à la charge de l'employeur et
      autant retenu au salarié. Ces deux règles ne produisent un montant que sur
      les heures portant un code de statut A, E, H, I ou J ; elles restent à zéro
      pour un salarié ordinaire.
    -->

    <record id="rule_ccq_frais_participation" model="hr.salary.rule">
        <field name="name">Frais de participation aux régimes</field>
        <field name="code">CCQ_FRAIS_PARTICIPATION</field>
        <field name="sequence">39</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = - payslip._ccq_frais_participation()</field>
    </record>

    <record id="rule_ccq_frais_participation_emp" model="hr.salary.rule">
        <field name="name">Frais de participation aux régimes — part de l'employeur</field>
        <field name="code">CCQ_FRAIS_PARTICIPATION_EMP</field>
        <field name="sequence">120</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_frais_participation()</field>
    </record>

    <record id="rule_ccq_conges" model="hr.salary.rule">
        <field name="name">Congés, fériés et maladie CCQ (13 %)</field>
        <field name="code">CCQ_CONGES</field>
        <field name="sequence">110</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_conges()</field>
    </record>
</odoo>
