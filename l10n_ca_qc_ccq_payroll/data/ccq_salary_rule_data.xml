<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Règles de paie de la couche construction.

      Elles se greffent sur la structure « Paie régulière — Québec » du module
      de base : le bulletin d'un salarié de chantier et celui d'un salarié de
      bureau restent le même document, seules les lignes diffèrent.

      Catégorie BASIC et séquences 11 et 12 : les heures majorées sont donc
      reprises telles quelles par le brut (séquence 20) et par le net
      (séquence 90), et servent d'assiette aux cotisations comme à l'indemnité
      de vacances — ce qui est exact, le temps supplémentaire est un revenu
      d'emploi ordinaire, imposé normalement.

      Le brut des heures régulières n'a pas sa propre règle : la règle BASIC du
      module de base appelle _l10n_ca_qc_basic(), que ce module surcharge.
    -->

    <!-- 11 — Heures supplémentaires à taux et demi -->
    <record id="rule_ccq_heures_supp_50" model="hr.salary.rule">
        <field name="name">Heures supplémentaires (+50 %)</field>
        <field name="code">CCQ_HS50</field>
        <field name="sequence">11</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_heures_supp_50()</field>
    </record>

    <!-- 12 — Heures supplémentaires à taux double -->
    <record id="rule_ccq_heures_supp_100" model="hr.salary.rule">
        <field name="name">Heures supplémentaires (+100 %)</field>
        <field name="code">CCQ_HS100</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_heures_supp_100()</field>
    </record>

    <record id="rule_ccq_primes" model="hr.salary.rule">
        <field name="name">Primes de convention</field>
        <field name="code">CCQ_PRIMES</field>
        <field name="sequence">13</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_primes()</field>
    </record>

    <record id="rule_ccq_conges" model="hr.salary.rule">
        <field name="name">Congés, fériés et maladie CCQ (13 %)</field>
        <field name="code">CCQ_CONGES</field>
        <field name="sequence">110</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="struct_id" ref="l10n_ca_qc_hr_payroll.structure_qc_regular"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._ccq_conges()</field>
    </record>
</odoo>
