<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ajoute le taux CNESST sur la fiche société (donnée propre à l'employeur,
         saisie par l'utilisateur). -->
    <record id="view_company_form_qc_payroll" model="ir.ui.view">
        <field name="name">res.company.form.qc.payroll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="l10n_ca_qc_cnesst_rate"/>
                <field name="l10n_ca_qc_rp_number"/>
                <field name="l10n_ca_qc_rs_number"/>
            </field>
        </field>
    </record>
</odoo>
