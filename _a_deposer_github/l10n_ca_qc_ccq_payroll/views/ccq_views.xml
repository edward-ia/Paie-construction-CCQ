    <record id="action_ccq_bareme_deplacement" model="ir.actions.act_window">
        <field name="name">Barèmes de déplacement</field>
        <field name="res_model">ccq.bareme.deplacement</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ================================================================
         MENUS
         ================================================================ -->

    <menuitem id="menu_ccq_root" name="Construction (CCQ)"
              groups="hr.group_hr_user" sequence="95"/>

    <menuitem id="menu_ccq_operations" name="Opérations"
              parent="menu_ccq_root" sequence="10"/>
    <menuitem id="menu_ccq_feuille_temps" name="Feuilles de temps"
              parent="menu_ccq_operations" action="action_ccq_feuille_temps" sequence="10"/>
    <menuitem id="menu_ccq_chantier" name="Chantiers"
              parent="menu_ccq_operations" action="action_ccq_chantier" sequence="20"/>

    <menuitem id="menu_ccq_config" name="Configuration"
              parent="menu_ccq_root" groups="hr.group_hr_manager" sequence="90"/>
    <menuitem id="menu_ccq_metier" name="Métiers et occupations"
              parent="menu_ccq_config" action="action_ccq_metier" sequence="10"/>
    <menuitem id="menu_ccq_secteur" name="Secteurs"
              parent="menu_ccq_config" action="action_ccq_secteur" sequence="20"/>
    <menuitem id="menu_ccq_annexe" name="Annexes de salaire"
              parent="menu_ccq_config" action="action_ccq_annexe" sequence="30"/>
    <menuitem id="menu_ccq_region" name="Régions"
              parent="menu_ccq_config" action="action_ccq_region" sequence="40"/>
    <menuitem id="menu_ccq_association" name="Associations syndicales"
              parent="menu_ccq_config" action="action_ccq_association" sequence="50"/>
    <menuitem id="menu_ccq_local" name="Locaux syndicaux"
              parent="menu_ccq_config" action="action_ccq_local" sequence="60"/>
    <menuitem id="menu_ccq_prime" name="Primes de convention"
              parent="menu_ccq_config" action="action_ccq_prime" sequence="70"/>
    <menuitem id="menu_ccq_taux_salaire" name="Taux de salaire"
              parent="menu_ccq_config" action="action_ccq_taux_salaire" sequence="80"/>
    <menuitem id="menu_ccq_taux_qualification" name="Fonds de qualification"
              parent="menu_ccq_config" action="action_ccq_taux_qualification" sequence="90"/>
    <menuitem id="menu_ccq_bareme_deplacement" name="Barèmes de déplacement"
              parent="menu_ccq_config" action="action_ccq_bareme_deplacement" sequence="100"/>

</odoo>
