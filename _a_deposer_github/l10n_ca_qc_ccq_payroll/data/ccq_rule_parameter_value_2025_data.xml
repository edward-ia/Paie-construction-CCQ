<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      ================================================================
      PARAMÈTRES CCQ — CONVENTION 2025-2029
      ================================================================
      Source : Commission de la construction du Québec,
               « Guide pour remplir le rapport mensuel » (PD5277).

      DATE D'ENTRÉE EN VIGUEUR : fixée au 27 avril 2025, début de la période
      conventionnée 2025-2029. ⚠️ La date exacte d'entrée en vigueur de CHAQUE
      valeur n'a pas été recoupée une à une dans le guide ; si l'une d'elles a
      changé à une autre date, créer un fichier de millésime supplémentaire
      plutôt que de modifier celui-ci — l'historique doit rester rejouable.

      Les pourcentages sont exprimés en décimal (0.0075 = 0,75 %).
      NE PAS modifier dans l'interface : ces valeurs produisent des remises légales.
    -->

    <!-- Heures supplémentaires — convention IC 2025-2029 (PD5145), section XXI.
         Première heure supplémentaire majorée de 50 %, puis 100 % dès la
         deuxième. Le dimanche et les jours fériés chômés : 100 % dès la
         première heure. Durée normale : 8 h par jour, 40 h du lundi au
         vendredi (section XX).
         ⚠️ Les seuils servent à répartir les heures à la saisie ; la
         répartition entre régulières, +50 % et +100 % est portée par la
         feuille de temps, jamais recalculée au moment de la paie. -->
    <record id="val_ccq_heures_supp_2025" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_ccq_heures_supp"/>
        <field name="date_from">2025-04-27</field>
        <field name="parameter_value">{'majoration_50': 1.5, 'majoration_100': 2.0, 'seuil_quotidien': 8.0, 'seuil_hebdo': 40.0}</field>
    </record>

    <!-- Prélèvement CCQ : 0,75 % salarié + 0,75 % employeur = 1,5 %.
         ⚠️ La base n'est PAS le brut fiscal : c'est le salaire cotisable PLUS le
         montant des congés et fériés (le 13 %). Minimum de 10 $ par mois, dû même
         en l'absence d'activité. -->
    <record id="val_ccq_prelevement_2025" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_ccq_prelevement"/>
        <field name="date_from">2025-04-27</field>
        <field name="parameter_value">{'taux_salarie': 0.0075, 'taux_employeur': 0.0075, 'min_mensuel': 10.0}</field>
    </record>

    <!-- Congés annuels 6 % + jours fériés 5,5 % + congés de maladie 1,5 % = 13 %
         du salaire cotisable.
         ⚠️ PAYÉ PAR L'EMPLOYEUR, ce n'est PAS une retenue sur la paie du salarié.
         ⚠️ Ce montant n'est PAS imposé sur la paie hebdomadaire : c'est la CCQ qui
         retient l'impôt et émet les feuillets quand elle le décaisse au travailleur,
         deux fois par année. L'inclure dans la base imposable sur-retiendrait toute
         l'année. -->
    <record id="val_ccq_conges_2025" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_ccq_conges"/>
        <field name="date_from">2025-04-27</field>
        <field name="parameter_value">{'conges_annuels': 0.06, 'jours_feries': 0.055, 'maladie': 0.015}</field>
    </record>

    <!-- Fonds de formation : 0,20 $ par heure travaillée, à la charge de l'employeur. -->
    <record id="val_ccq_fonds_formation_2025" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_ccq_fonds_formation"/>
        <field name="date_from">2025-04-27</field>
        <field name="parameter_value">0.20</field>
    </record>

    <!-- Fonds d'indemnisation : 0,02 $ par heure travaillée, à la charge de l'employeur. -->
    <record id="val_ccq_fonds_indemnisation_2025" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_ccq_fonds_indemnisation"/>
        <field name="date_from">2025-04-27</field>
        <field name="parameter_value">0.02</field>
    </record>

    <!-- Contribution sectorielle : le PAYEUR change selon le secteur.
         Institutionnel-commercial, industriel et génie civil : 0,02 $/h payé par le
         SALARIÉ (c'est la ligne « CONT. SEC. CCQ » des talons).
         Résidentiel : 0,04 $/h payé par l'EMPLOYEUR.
         Clé = code du secteur (ccq.secteur.code). -->
    <record id="val_ccq_contribution_sectorielle_2025" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_ccq_contribution_sectorielle"/>
        <field name="date_from">2025-04-27</field>
        <field name="parameter_value">{'IC': {'taux': 0.02, 'payeur': 'salarie'}, 'IND': {'taux': 0.02, 'payeur': 'salarie'}, 'GCV': {'taux': 0.02, 'payeur': 'salarie'}, 'RES': {'taux': 0.04, 'payeur': 'employeur'}}</field>
    </record>

    <!-- Associations patronales : AECQ 0,03 $/h, plus ACQ 0,03 $/h en
         institutionnel-commercial. Taxes en sus, minimum de 5 $ par mois.
         La cotisation annuelle de 240 $ à l'AECQ se paie en UN versement, avec le
         rapport du mois d'octobre. -->
    <record id="val_ccq_associations_patronales_2025" model="hr.rule.parameter.value">
        <field name="rule_parameter_id" ref="rule_param_ccq_associations_patronales"/>
        <field name="date_from">2025-04-27</field>
        <field name="parameter_value">{'aecq_horaire': 0.03, 'acq_horaire_ic': 0.03, 'min_mensuel': 5.0, 'aecq_annuelle': 240.0, 'mois_cotisation_annuelle': 10}</field>
    </record>

    <!--
      AUCUNE valeur pour l10n_ca_qc_ccq_taxe_assurance : le taux reste à obtenir.
      Voir le commentaire dans ccq_rule_parameter_data.xml.
    -->
</odoo>
